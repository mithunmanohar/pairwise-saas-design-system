{
  "name": "@pairwise/ui",
  "version": "1.0.0",
  "description": "Pairwise design system: tokens, styles and React components for ML platforms, AI applications and SaaS.",
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "design-tokens",
    "component-library",
    "ui-kit",
    "saas",
    "ml-platform",
    "llm",
    "agentic-ai",
    "aiops",
    "multi-tenant",
    "platform-engineering",
    "dashboard",
    "observability",
    "dark-mode",
    "accessibility",
    "wcag",
    "radix-ui"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.1.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.1.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1"
  }
}
